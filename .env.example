# Konfigurasi Lingkungan Skilllevel

# 1. Konfigurasi Endpoint & Model AI
# Model Bawaan Otomatis (Tanpa Perlu API Key Pengguna):
# - Inception Labs: Mercury=https://api.inceptionlabs.ai/v1 | AI_MODEL=mercury-3
# - Agnes AI: Agnes=https://apihub.agnes-ai.com/v1 | AI_MODEL=agnes-2.5-flash

# Endpoint Bawaan (Opsional, bawaan server sudah aktif otomatis)
Mercury=https://api.inceptionlabs.ai/v1
Agnes=https://apihub.agnes-ai.com/v1

# Protokol penyedia: openai (bawaan & Inception Labs), anthropic, atau gemini
AI_PROVIDER=openai

# Kredensial server model bawaan (Mendukung multi-kunci cadangan koma: key1,key2...)
Mercury_key=
Agnes_key=

# Streaming jawaban: 1 = aktif, 0 = nonaktif
AI_STREAMING=1

# Mode penalaran berpikir: auto = kirim parameter thinking, off = tidak
AI_THINKING=auto

# Izinkan endpoint localhost / jaringan privat (hanya pengembangan lokal: 1 = ya, 0 = tidak)
AI_ALLOW_PRIVATE_ENDPOINTS=0

# Batas total karakter input konteks per permintaan
AI_MAX_INPUT_CHARS=120000

# 2. Keamanan Server & Enkripsi
SERVER_ENCRYPTION_KEY=skilllevel-super-secret-key-production-32-chars

# 3. Supabase Auth & Database (Opsional untuk Sinkronisasi Cloud)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
