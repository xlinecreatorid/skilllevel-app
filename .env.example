# Konfigurasi Lingkungan Skilllevel

# 1. Konfigurasi Endpoint & Model AI
# Model Bawaan / Model Gratis Rekomendasi:
# - Inception Labs: AI_BASE_URL=https://api.inceptionlabs.ai/v1 | AI_MODEL=mercury-3
# - Agnes AI: AI_BASE_URL=https://apihub.agnes-ai.com/v1 | AI_MODEL=agnes-2.5-flash
# - Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/v1 | AI_MODEL=gemini-2.0-flash
AI_BASE_URL=https://api.inceptionlabs.ai/v1
AI_MODEL=mercury-3

# Protokol penyedia: openai (bawaan & Inception Labs), anthropic, atau gemini
AI_PROVIDER=openai

# Kredensial utama server (tidak pernah dikirim ke browser)
AI_API_KEY=

# Kunci API cadangan berurutan (dipisahkan tanda koma) jika kuota kunci utama habis / 429
AI_API_KEY_FALLBACKS=

# Streaming jawaban: 1 = aktif, 0 = nonaktif
AI_STREAMING=1

# Mode penalaran berpikir: auto = kirim parameter thinking, off = tidak
AI_THINKING=auto

# Izinkan endpoint localhost / jaringan privat (hanya pengembangan lokal: 1 = ya, 0 = tidak)
AI_ALLOW_PRIVATE_ENDPOINTS=0

# Batas total karakter input konteks per permintaan
AI_MAX_INPUT_CHARS=120000

# 2. Keamanan Server & Enkripsi
SERVER_ENCRYPTION_KEY=skilllevel-super-secret-key-production-32-chars

# 3. Supabase Auth & Database (Opsional untuk Google OAuth & Cloud Sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
